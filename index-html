<title>Informazioni sui finanziamenti</title>
<style>
body{margin:0;font-family:Arial;background:#f3f6fa;color:#263447;line-height:1.6}
header,footer{background:#05294d;color:white;padding:22px 7%}
nav a{color:white;margin-right:15px;text-decoration:none}
.hero{background:linear-gradient(120deg,#05294d,#073b70);color:white;padding:65px 7%}
h1{font-size:38px}
.hero p{max-width:650px}
main{max-width:950px;margin:auto;padding:35px 7%}
h2,h3{color:#073b70}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:18px}
.card{background:white;padding:22px;border-radius:10px;border:1px solid #ddd}
.notice{background:#fff8e9;padding:18px;border-left:4px solid #d9b56d}
